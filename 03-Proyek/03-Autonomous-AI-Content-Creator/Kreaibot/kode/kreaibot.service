[Unit]
Description=Kreaibot — Telegram AI content studio bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/kreaibot
EnvironmentFile=/root/projects/kreaibot/.env
ExecStart=/root/projects/kreaibot/.venv/bin/python3 /root/projects/kreaibot/bot.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/kreaibot.log
StandardError=append:/var/log/kreaibot.log

[Install]
WantedBy=multi-user.target
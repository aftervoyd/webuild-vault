# === WAJIB: dari @BotFather ===
KREAIBOT_TOKEN=
KREAIBOT_NAME=KREE.AI
KREAIBOT_ADMIN_IDS=8886993492

# === Ekonomi token ===
KREAIBOT_TOKENS_PER_10K=10
KREAIBOT_HARGA_10K=10000
KREAIBOT_SIGNUP_BONUS=1

# === Backend generate: mock | runninghub | fal ===
KREAIBOT_BACKEND=runninghub

# Info pembayaran yang tampil di menu Top Up (teks bebas).
KREAIBOT_PAY_INFO=💳 QRIS/transfer ke admin (isi KREAIBOT_PAY_INFO di .env)

# RunningHub (ComfyUI cloud — sama seperti kompetitor)
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE=https://www.runninghub.ai
RUNNINGHUB_WF_ALLINONE=
RUNNINGHUB_WF_I2V=2084116925483151361
RUNNINGHUB_WF_FACESWAP=
RUNNINGHUB_WF_POSE=
RUNNINGHUB_WF_LIPSYNC=
RUNNINGHUB_WF_EDITOR=
# binding node: JSON list {nodeId, fieldName, value(@photo1..@photo6/@prompt/@ratio/@video)}
RUNNINGHUB_NODES_ALLINONE=[]
RUNNINGHUB_NODES_I2V=[]
RUNNINGHUB_NODES_LIPSYNC=[]

# fal.ai (opsional)
FAL_KEY=
FAL_MODEL_ALLINONE=minimax/hailuo-03/image-to-video

# === Pembayaran (stub dulu) ===
KREAIBOT_PAYMENT=manual
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=

# === RunningHub (mesin render asli) ===
# Ambil API key di runninghub.ai → menu API Key → Create → tipe "Consumer-Member".
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE=https://www.runninghub.ai

# workflowId per fitur (angka 19 digit dari URL workflow).
# FL2VA "MiniMax H3 first-last frame to Video" (2084116925483151361) = cocok untuk allinone
# (foto 1 = frame awal, foto 2 = frame akhir). Node map ada di workflows/minimax-h3-fl2va.json
RUNNINGHUB_WF_ALLINONE=2084116925483151361
RUNNINGHUB_WF_I2V=2084116925483151361
RUNNINGHUB_WF_UGC=

# Binding node: JSON list {"nodeId","fieldName","value"}.
# Placeholder yang dikenali: @photo1..@photo6, @prompt, @ratio, @duration, @width, @height, @video
# (nama field persis dicek dulu dengan: .venv/bin/python tools/rh_inspect.py <workflowId>)
RUNNINGHUB_NODES_ALLINONE=[{"nodeId":"4","fieldName":"image","value":"@photo1"},{"nodeId":"6","fieldName":"image","value":"@photo2"},{"nodeId":"8","fieldName":"prompt","value":"@prompt"},{"nodeId":"7","fieldName":"aspect_ratio","value":"@ratio"},{"nodeId":"7","fieldName":"duration_seconds","value":"@duration"},{"nodeId":"7","fieldName":"width","value":"@width"},{"nodeId":"7","fieldName":"height","value":"@height"}]

# === PromptSmith (perakit prompt UGC) ===
# Kosongkan kalau mau pakai template offline saja (tetap jalan, tanpa biaya).
PROMPTSMITH_BASE_URL=
PROMPTSMITH_API_KEY=
PROMPTSMITH_MODEL=

# === Sistem ===
KREAIBOT_CONCURRENCY=3
KREAIBOT_POLL_INTERVAL=5
KREAIBOT_JOB_TIMEOUT=900